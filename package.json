  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  }
}
